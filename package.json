{
  "name": "vertex-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.dev -- next dev",
    "build": "dotenv -e .env.prod -- next build",
    "start": "dotenv -e .env.prod -- next start",
    "lint": "next lint",
    "db:push": "dotenv -e .env.dev -- prisma db push --accept-data-loss",
    "db:push:prod": "dotenv -e .env.prod -- prisma db push",
    "db:studio": "dotenv -e .env.dev -- prisma studio",
    "db:seed": "dotenv -e .env.dev -- tsx prisma/seed.ts"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@auth/prisma-adapter": "^2.7.2",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^4.10.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.447.0",
    "mathjs": "^15.2.0",
    "next": "^14.2.30",
    "next-auth": "^4.24.11",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
